APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/market_predictor.db
FEED_PROVIDER=mock
MOCK_TIME_ACCELERATION=60
# Only used when FEED_PROVIDER=twelve_data. Get a free key at twelvedata.com.
TWELVE_DATA_API_KEY=
CORS_ORIGINS=http://localhost:5173
SYMBOLS=XAUUSD,EURUSD,AUDUSD
TIMEFRAMES=1m,5m,15m,1h,4h
# Optional second, independent market-data pipeline using TradingView's
# unofficial WebSocket protocol (own DB tables, runs alongside the feed
# above rather than replacing it). Off by default — it can break if
# TradingView changes the protocol. See app/services/tradingview_feed_service.py.
TRADINGVIEW_ENABLED=false
TRADINGVIEW_EXCHANGE=OANDA
TRADINGVIEW_POLL_INTERVAL_SECONDS=15
